# Скопируй в .env и задай уникальный сильный пароль (файл .env не коммитить).
POSTGRES_USER=appuser
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
POSTGRES_DB=app_dev
POSTGRES_HOST_PORT=15432
API_HOST_PORT=5080

# Необязательно: SQL Server — альтернативная СУБД (Compose profile sqlserver).
# Для его запуска отдельно задай MSSQL_SA_PASSWORD и при желании порт.
SQLSERVER_HOST_PORT=14333
# MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
