  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="ДЗ №4. Обновление ленты через очередь">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="fixturePassword" elementType="Argument">
            <stringProp name="Argument.name">fixturePassword</stringProp>
            <stringProp name="Argument.value">${__UUID()}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
