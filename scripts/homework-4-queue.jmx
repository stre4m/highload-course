                <stringProp name="Argument.value">{&quot;first_name&quot;:&quot;Feed&quot;,&quot;second_name&quot;:&quot;JMeter&quot;,&quot;birthdate&quot;:&quot;2000-01-01&quot;,&quot;gender&quot;:&quot;test&quot;,&quot;biography&quot;:&quot;HW4 JMeter fixture&quot;,&quot;city&quot;:&quot;Test&quot;,&quot;password&quot;:&quot;${fixturePassword}&quot;}</stringProp>
